# Browser client: point this at a deployed server-side proxy.
# Never put a Gemini API key in a VITE_* variable; Vite exposes it in the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8787

# Server-side only. Copy to .env.local and keep it out of Git.
GEMINI_API_KEY=replace-with-your-server-side-key
GEMINI_MODEL=gemini-3.6-flash
ALLOWED_ORIGIN=http://127.0.0.1:4627
